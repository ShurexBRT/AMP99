{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMP99",
  "version": "0.2.0-alpha.1",
  "identifier": "dev.amp99.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AMP99 — Play it like it's 1999",
        "width": 275,
        "height": 116,
        "x": 120,
        "y": 120,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#090b0e"
      },
      {
        "label": "equalizer",
        "title": "AMP99 Equalizer",
        "width": 275,
        "height": 116,
        "x": 120,
        "y": 236,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "backgroundColor": "#090b0e"
      },
      {
        "label": "playlist",
        "title": "AMP99 Playlist Editor",
        "width": 275,
        "height": 232,
        "x": 395,
        "y": 120,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "backgroundColor": "#090b0e",
        "minWidth": 275,
        "minHeight": 145
      },
      {
        "label": "preferences",
        "title": "AMP99 Preferences",
        "width": 390,
        "height": 475,
        "x": 260,
        "y": 180,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "backgroundColor": "#15171a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "publisher": "Predrag Jovanovic",
    "shortDescription": "Classic late-90s desktop music player with legacy skin support.",
    "longDescription": "AMP99 is a free retro desktop music player inspired by late-90s desktop player workflows. Play it like it's 1999.",
    "fileAssociations": [
      {
        "ext": [
          "wsz"
        ],
        "name": "AMP99 Skin",
        "description": "AMP99 / Winamp-compatible skin"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.2.0.1"
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMP99",
  "version": "0.1.0",
  "identifier": "dev.amp99.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMP99 — Play it like it's '99",
        "width": 900,
        "height": 620,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#090b0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Predrag Jovanovic",
    "shortDescription": "Classic late-90s music player experience for Spotify.",
    "longDescription": "AMP99 is a free retro desktop music player inspired by late-90s media player workflows. Play it like it's '99."
  }
}
